{
  "name": "chesslab.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify && npm run copy:fonts && npm run copy:chessboard",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch",
    "copy:fonts": "node -e \"const fs=require('fs'); fs.cpSync('node_modules/@fontsource/jetbrains-mono/files','wwwroot/css/files',{recursive:true}); fs.cpSync('node_modules/@fontsource/noto-sans-symbols-2/files','wwwroot/css/files',{recursive:true})\"",
    "copy:chessboard": "node -e \"const fs=require('fs'); fs.cpSync('node_modules/cm-chessboard/src','wwwroot/js/cm-chessboard/src',{recursive:true}); fs.cpSync('node_modules/cm-chessboard/assets/pieces/standard.svg','wwwroot/js/cm-chessboard/assets/pieces/standard.svg'); fs.cpSync('node_modules/cm-chessboard/assets/chessboard.css','wwwroot/js/cm-chessboard/assets/chessboard.css'); fs.cpSync('node_modules/cm-chessboard/assets/extensions/markers/markers.css','wwwroot/js/cm-chessboard/assets/extensions/markers/markers.css'); fs.cpSync('node_modules/cm-chessboard/assets/extensions/markers/markers.svg','wwwroot/js/cm-chessboard/assets/extensions/markers/markers.svg'); fs.cpSync('node_modules/cm-chessboard/assets/extensions/promotion-dialog/promotion-dialog.css','wwwroot/js/cm-chessboard/assets/extensions/promotion-dialog/promotion-dialog.css')\""
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "cm-chessboard": "^8.12.19"
  }
}
