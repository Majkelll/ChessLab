{
  "name": "brainandhand.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify && npm run copy:fonts",
    "watch:css": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch",
    "copy:fonts": "node -e \"require('fs').cpSync('node_modules/@fontsource/jetbrains-mono/files','wwwroot/css/files',{recursive:true})\""
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
