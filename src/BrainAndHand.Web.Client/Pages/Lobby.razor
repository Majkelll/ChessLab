@page "/room/{Code}"
@attribute [Authorize]
@using BrainAndHand.Core.Chess
@using BrainAndHand.Core.Contracts
@using BrainAndHand.Core.Rooms
@using BrainAndHand.Web.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject GameClient Game
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Room @Code</PageTitle>

<div class="flex flex-wrap items-center justify-between gap-3">
    <div>
        <h1 class="text-xl font-semibold">Room <span data-testid="room-code" class="tracking-widest">@Code</span></h1>
        <p class="mt-1 text-sm text-[#2b20196b]">Send this code to friends so they can join.</p>
    </div>
    <button data-testid="copy-link-btn"
            @onmousedown="() => { }" @onmousedown:preventDefault="true"
            @onclick="CopyLinkAsync"
            class="border border-[#2b201929] bg-white/40 px-3 py-1.5 font-mono text-sm hover:border-amber-600/60 transition duration-300 hover:cursor-pointer">
        Copy link
    </button>
</div>

@if (error is not null)
{
    <p data-testid="lobby-error" class="mt-4 text-sm text-red-500">@error</p>
}
else if (room is null)
{
    <p class="mt-6 text-[#2b20196b]">Connecting…</p>
}
else
{
    <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
        @foreach (var side in new[] { Side.White, Side.Black })
        {
            <div class="flex flex-col gap-3">
                <div>
                    <h2 class="text-sm font-normal text-amber-700">@(side == Side.White ? "WHITE" : "BLACK")</h2>
                    <div class="h-1 w-full border-b border-[#2b201929]"></div>
                </div>
                @foreach (var role in new[] { SeatRole.Brain, SeatRole.Hand })
                {
                    var seatId = new SeatId(side, role);
                    var seat = room.Seats.Single(s => s.Id == seatId);
                    <div data-testid="@($"seat-{side}-{role}")"
                         class="flex flex-wrap items-center justify-between gap-2 border border-[#2b201929] bg-white/40 px-3 py-2 hover:border-amber-600/60 transition duration-300">
                        <span class="text-sm text-[#2b20196b]">@(role == SeatRole.Brain ? "Brain" : "Hand")</span>
                        @if (seat.Kind == OccupantKind.Empty)
                        {
                            <div class="flex items-center gap-2">
                                <button data-testid="seat-join-btn"
                                        @onmousedown="() => { }" @onmousedown:preventDefault="true"
                                        @onclick="() => ClaimSeatAsync(seatId)"
                                        class="border border-amber-700/40 bg-amber-700/5 px-2 py-1 font-mono text-sm hover:bg-amber-700/20 transition duration-300 hover:cursor-pointer">
                                    Join
                                </button>
                                <button data-testid="seat-add-bot-btn"
                                        @onmousedown="() => { }" @onmousedown:preventDefault="true"
                                        @onclick="() => AddBotAsync(seatId)"
                                        class="border border-[#2b201929] bg-white/60 px-2 py-1 font-mono text-sm hover:border-amber-600/60 transition duration-300 hover:cursor-pointer">
                                    Add bot
                                </button>
                            </div>
                        }
                        else if (seat.Kind == OccupantKind.Bot)
                        {
                            <span class="flex items-center gap-2 text-sm">
                                <select data-testid="seat-bot-select"
                                        class="border border-[#2b201929] bg-white/60 px-1 py-1 font-mono text-xs focus:border-amber-600/60 focus:outline-none"
                                        @onchange="e => SetSeatBotAsync(seatId, e.Value!.ToString()!)">
                                    <option value="Easy" selected="@(seat.Difficulty == BotDifficulty.Easy)">Easy</option>
                                    <option value="Medium" selected="@(seat.Difficulty == BotDifficulty.Medium)">Medium</option>
                                    <option value="Hard" selected="@(seat.Difficulty == BotDifficulty.Hard)">Hard</option>
                                    <option value="Expert" selected="@(seat.Difficulty == BotDifficulty.Expert)">Expert</option>
                                </select>
                                <button data-testid="seat-remove-btn"
                                        @onmousedown="() => { }" @onmousedown:preventDefault="true"
                                        @onclick="() => ClearSeatAsync(seatId)" class="-m-2 p-2 text-xs text-[#2b20196b] underline hover:text-amber-700">remove</button>
                            </span>
                        }
                        else
                        {
                            <span data-testid="seat-occupant-name" class="text-sm">
                                @seat.DisplayName
                                @if (seat.UserId == myUserId)
                                {
                                    <button data-testid="seat-leave-btn"
                                            @onmousedown="() => { }" @onmousedown:preventDefault="true"
                                            @onclick="() => LeaveSeatAsync(seatId)" class="-m-2 ml-0 p-2 text-xs text-[#2b20196b] underline hover:text-amber-700">leave</button>
                                }
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2 text-sm">
        <span class="text-[#2b20196b]">Clock:</span>
        @if (room.HostUserId == myUserId)
        {
            <input type="number" min="1" max="180" data-testid="clock-initial-minutes"
                   value="@clockMinutes"
                   @onchange="OnClockMinutesChangedAsync"
                   class="w-14 border border-[#2b201929] bg-white/60 px-2 py-1 font-mono text-xs focus:border-amber-600/60 focus:outline-none" />
            <span class="text-[#2b20196b]">min +</span>
            <input type="number" min="0" max="60" data-testid="clock-increment-seconds"
                   value="@clockIncrementSeconds"
                   @onchange="OnClockIncrementChangedAsync"
                   class="w-14 border border-[#2b201929] bg-white/60 px-2 py-1 font-mono text-xs focus:border-amber-600/60 focus:outline-none" />
            <span class="text-[#2b20196b]">s increment</span>
        }
        else
        {
            <span data-testid="clock-settings-display">@(room.InitialClockSeconds / 60) min + @room.ClockIncrementSeconds s increment</span>
        }
    </div>

    @if (!IsFull())
    {
        <p data-testid="fill-seats-hint" class="mt-6 text-sm text-[#2b20196b]">
            Fill all 4 seats (by joining or picking a bot) before you can start.
        </p>
    }

    @if (room.HostUserId == myUserId)
    {
        <button data-testid="start-game-btn"
                @onmousedown="() => { }" @onmousedown:preventDefault="true"
                @onclick="async () => { if (IsFull() && !isStarting) await StartGameAsync(); }"
                aria-disabled="@((!IsFull() || isStarting) ? "true" : "false")"
                class="mt-4 border border-amber-700/40 bg-amber-700/5 px-6 py-2 font-mono text-sm transition duration-300 @(!IsFull() || isStarting ? "cursor-not-allowed opacity-40" : "hover:bg-amber-700/20 hover:cursor-pointer")">
            Start game
        </button>
    }
    else if (IsFull())
    {
        <p data-testid="waiting-for-host" class="mt-4 text-sm text-[#2b20196b]">Waiting for the host to start the game.</p>
    }
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private RoomStateDto? room;
    private Guid myUserId;
    private string? error;
    private bool isStarting;

    // Seeded once from the room's current clock settings, then only ever changed by the host's
    // own edits — re-syncing from every RoomUpdated broadcast (e.g. another player joining a
    // seat) would otherwise risk clobbering an in-progress edit before it's committed.
    private int clockMinutes = 10;
    private int clockIncrementSeconds;
    private bool clockSettingsInitialized;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask!;
        myUserId = Guid.Parse(authState.User.FindFirst("buid")!.Value);

        Game.RoomUpdated += OnRoomUpdated;
        Game.GameUpdated += OnGameUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await Game.EnsureConnectedAsync();
            room = await Game.JoinRoomAsync(Code);
            if (room.HasStarted)
            {
                Nav.NavigateTo($"/game/{Code}");
                return;
            }
            InitializeClockSettingsOnce(room);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            StateHasChanged();
        }
    }

    private bool IsFull() => room is not null && room.Seats.All(s => s.Kind != OccupantKind.Empty);

    private void InitializeClockSettingsOnce(RoomStateDto currentRoom)
    {
        if (clockSettingsInitialized)
            return;

        clockMinutes = currentRoom.InitialClockSeconds / 60;
        clockIncrementSeconds = currentRoom.ClockIncrementSeconds;
        clockSettingsInitialized = true;
    }

    private Task OnClockMinutesChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var minutes) || minutes <= 0)
            return Task.CompletedTask;

        clockMinutes = minutes;
        return UpdateClockSettingsAsync();
    }

    private Task OnClockIncrementChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var seconds) || seconds < 0)
            return Task.CompletedTask;

        clockIncrementSeconds = seconds;
        return UpdateClockSettingsAsync();
    }

    private async Task UpdateClockSettingsAsync()
    {
        try { room = await Game.SetClockSettingsAsync(Code, clockMinutes * 60, clockIncrementSeconds); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ClaimSeatAsync(SeatId seatId)
    {
        try { room = await Game.ClaimSeatAsync(Code, seatId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LeaveSeatAsync(SeatId seatId)
    {
        try { room = await Game.LeaveSeatAsync(Code, seatId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AddBotAsync(SeatId seatId)
    {
        try { room = await Game.SetSeatBotAsync(Code, seatId, BotDifficulty.Medium); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SetSeatBotAsync(SeatId seatId, string difficultyValue)
    {
        if (string.IsNullOrEmpty(difficultyValue) || !Enum.TryParse<BotDifficulty>(difficultyValue, out var difficulty))
            return;

        try { room = await Game.SetSeatBotAsync(Code, seatId, difficulty); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ClearSeatAsync(SeatId seatId)
    {
        try { room = await Game.ClearSeatAsync(Code, seatId); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task StartGameAsync()
    {
        isStarting = true;
        try { await Game.StartGameAsync(Code); }
        catch (Exception ex) { error = ex.Message; isStarting = false; }
    }

    private async Task CopyLinkAsync()
    {
        var url = Nav.ToAbsoluteUri($"/room/{Code}").ToString();
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private void OnRoomUpdated(RoomStateDto dto)
    {
        room = dto;
        InvokeAsync(StateHasChanged);
    }

    private void OnGameUpdated(GameStateDto dto)
    {
        InvokeAsync(() => Nav.NavigateTo($"/game/{Code}"));
    }

    public void Dispose()
    {
        Game.RoomUpdated -= OnRoomUpdated;
        Game.GameUpdated -= OnGameUpdated;
    }
}
