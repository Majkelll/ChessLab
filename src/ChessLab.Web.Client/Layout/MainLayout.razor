@inherits LayoutComponentBase
@using System.Reflection
@using ChessLab.Web.Client.Services
@inject CurrentGameContext GameContext
@implements IDisposable

<div class="flex h-dvh flex-col bg-cream text-espresso font-mono">
    <header class="grain-wood flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-espresso/16 bg-paper px-4 py-3 sm:px-8">
        <a href="" class="flex items-baseline gap-2 text-lg font-semibold tracking-tight">
            <span class="hidden text-xs font-normal text-espresso-soft/70 sm:inline">~/majkel-games$</span>
            <span>
                @GameContext.GameName<span aria-hidden="true"
                    class="blink-cursor ml-0.5 inline-block h-[1em] w-[2px] translate-y-[3px] bg-amber-700"></span>
            </span>
        </a>
        <LoginDisplay />
    </header>

    <main class="mx-auto w-full min-h-0 max-w-5xl flex-1 overflow-y-auto px-4 py-4 sm:px-8">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed inset-x-0 bottom-0 hidden border-t border-espresso/16 bg-paper p-3 text-center font-mono text-sm">
    An unexpected error occurred.
    <a href="." class="text-amber-700 underline hover:text-amber-600">Reload</a>
    <span class="cursor-pointer">🗙</span>
</div>

<span class="fixed bottom-2 right-3 font-mono text-xs text-espresso/50 select-none max-lg:hidden">@("v" + Version)</span>

@code {
    private static readonly string Version =
        typeof(MainLayout).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? "dev";

    protected override void OnInitialized() => GameContext.Changed += OnGameContextChanged;

    private void OnGameContextChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GameContext.Changed -= OnGameContextChanged;
}
