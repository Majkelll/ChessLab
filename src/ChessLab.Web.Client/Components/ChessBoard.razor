@using ChessLab.Core.Chess
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="board-frame select-none">
    <div class="h-full w-full border-4 border-espresso bg-espresso p-1.5 shadow-[inset_0_0_0_1px_rgba(246,239,228,0.08)]">
        <div @ref="boardContainer" data-testid="chess-board" data-available-moves="@MoveList()" class="h-full w-full"></div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Fen { get; set; } = "";
    [Parameter] public IReadOnlyList<ChessMove> AvailableMoves { get; set; } = [];
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public bool FlipBoard { get; set; }
    [Parameter] public EventCallback<ChessMove> OnMoveSelected { get; set; }

    [Parameter] public bool SquareSelect { get; set; }
    [Parameter] public IReadOnlyList<Square> SelectedSquares { get; set; } = [];
    [Parameter] public EventCallback<Square> OnSquareSelected { get; set; }

    private string MoveList() => string.Join(' ', AvailableMoves
        .Select(move => $"{move.From}{move.To}{(move.PromoteTo is { } promotion ? PromotionLetter(promotion) : "")}")
        .Distinct());

    private static string PromotionLetter(PieceKind kind) => kind switch
    {
        PieceKind.Queen => "q",
        PieceKind.Rook => "r",
        PieceKind.Bishop => "b",
        PieceKind.Knight => "n",
        _ => "",
    };

    private ElementReference boardContainer;
    private IJSObjectReference? jsModule;
    private IJSObjectReference? board;
    private DotNetObjectReference<ChessBoard>? dotNetRef;
    private string? syncedFen;
    private bool syncedFlip;
    private IReadOnlyList<ChessMove>? syncedMoves;
    private bool syncedInteractive;
    private bool syncedSquareSelect;
    private IReadOnlyList<Square>? syncedSelectedSquares;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            jsModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/chessboardInterop.js");
            board = await jsModule.InvokeAsync<IJSObjectReference>("create", boardContainer, dotNetRef, Fen, FlipBoard);
            syncedFen = Fen;
            syncedFlip = FlipBoard;
        }

        if (board is null)
            return;

        if (!firstRender && Fen != syncedFen)
        {
            syncedFen = Fen;
            await board.InvokeVoidAsync("setPosition", Fen, true);
        }

        if (!firstRender && FlipBoard != syncedFlip)
        {
            syncedFlip = FlipBoard;
            await board.InvokeVoidAsync("setOrientation", FlipBoard);
        }

        if (firstRender || !AvailableMoves.SequenceEqual(syncedMoves ?? []))
        {
            syncedMoves = AvailableMoves;
            var movesForJs = AvailableMoves.Select(m => new
            {
                from = m.From.ToString(),
                to = m.To.ToString(),
                promotion = PromotionChar(m.PromoteTo),
            });
            await board.InvokeVoidAsync("setLegalMoves", movesForJs);
        }

        if (firstRender || Interactive != syncedInteractive)
        {
            syncedInteractive = Interactive;
            await board.InvokeVoidAsync("setInteractive", Interactive);
        }

        if (firstRender || SquareSelect != syncedSquareSelect)
        {
            syncedSquareSelect = SquareSelect;
            await board.InvokeVoidAsync("setSquareSelect", SquareSelect);
        }

        if (firstRender || !SelectedSquares.SequenceEqual(syncedSelectedSquares ?? []))
        {
            syncedSelectedSquares = SelectedSquares.ToArray();
            await board.InvokeVoidAsync("setSelectedSquares", SelectedSquares.Select(s => s.ToString()));
        }
    }

    [JSInvokable]
    public Task OnSquareInput(string square) => OnSquareSelected.InvokeAsync(Square.Parse(square));

    [JSInvokable]
    public Task OnMoveInput(string from, string to, string? promotion)
    {
        var fromSquare = Square.Parse(from);
        var toSquare = Square.Parse(to);
        var promoteTo = ParsePromotion(promotion);

        var candidates = AvailableMoves
            .Where(m => m.From == fromSquare && m.To == toSquare && m.PromoteTo == promoteTo)
            .ToList();

        return candidates.Count == 0 ? Task.CompletedTask : OnMoveSelected.InvokeAsync(candidates[0]);
    }

    private static string? PromotionChar(PieceKind? kind) => kind switch
    {
        PieceKind.Queen => "q",
        PieceKind.Rook => "r",
        PieceKind.Bishop => "b",
        PieceKind.Knight => "n",
        _ => null,
    };

    private static PieceKind? ParsePromotion(string? promotion) => promotion switch
    {
        "q" => PieceKind.Queen,
        "r" => PieceKind.Rook,
        "b" => PieceKind.Bishop,
        "n" => PieceKind.Knight,
        _ => null,
    };

    public async ValueTask DisposeAsync()
    {
        if (board is not null)
        {
            await board.InvokeVoidAsync("destroy");
            await board.DisposeAsync();
        }

        if (jsModule is not null)
            await jsModule.DisposeAsync();

        dotNetRef?.Dispose();
    }
}
